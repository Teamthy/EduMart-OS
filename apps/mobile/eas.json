{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8080"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.staging.edumart.ng"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.edumart.ng"
      }
    }
  },
  "submit": {
    "production": {
      "android": { "serviceAccountKeyPath": "./secrets/play-service-account.json", "track": "internal" },
      "ios": { "appleId": "release@edumart.ng", "ascAppId": "0000000000" }
    }
  }
}
