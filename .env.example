# Local development database (SQLite file). Production target is managed PostgreSQL.
DATABASE_URL="file:./db/dev.db"

# Session cookie lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS="168"

# HMAC secret used to sign payment webhook payloads and entitlement access tokens.
# Override with a long random value in every deployed environment.
PAYMENT_WEBHOOK_SECRET="dev_sandbox_webhook_secret"

# Sandbox payment provider is disabled automatically in production unless explicitly enabled.
ALLOW_SANDBOX_PAYMENTS="false"
