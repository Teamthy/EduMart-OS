# ── API (apps/api) ───────────────────────────────────────────────────────────
PORT=8080
EDUMART_DRIVER=sqlite3
EDUMART_DSN=data/edumart.db
# Production engine (the same suite runs on it in CI):
#   docker compose -f infra/docker/compose.yml up -d postgres
# EDUMART_DRIVER=postgres
# EDUMART_DSN=postgres://edumart:local_only_change_me@localhost:5432/edumart?sslmode=disable

# Load taxonomy, products and demo accounts on boot (development only).
EDUMART_SEED=true
EDUMART_SEED_DEMO_USERS=true

# Payment webhooks: HMAC-SHA256 secret. Rotate per environment; never commit a live secret.
EDUMART_WEBHOOK_SECRET=dev_sandbox_webhook_secret
EDUMART_PAYMENT_PROVIDER=sandbox
# Selecting paystack moves refunds through the provider's API and verifies its HMAC-SHA512 callbacks with
# this key. Left unset while paystack is selected, refunds are recorded as failed — never as money moved.
# EDUMART_PAYSTACK_SECRET_KEY=
# EDUMART_PAYSTACK_BASE_URL=https://api.paystack.co
# Exposes POST /v1/orders/{id}/simulate-payment. Must be false in production.
EDUMART_ALLOW_SANDBOX_PAYMENTS=true

# Trust X-Forwarded-For / X-Real-Ip. Set true ONLY when a load balancer or reverse proxy sits in front
# of the API. When this is false the socket address is used, which is what stops a caller from choosing
# its own rate-limit bucket by rewriting a header.
EDUMART_TRUST_PROXY=false

# Bearer token required by GET /metrics. Leave unset locally: with no token the endpoint answers loopback
# only, so `curl localhost:8080/metrics` works and nothing else does.
# Connection pool for PostgreSQL. Unbounded is Go's default and a footgun: pick this against the database's
# own max_connections divided by the number of API replicas.
EDUMART_DB_MAX_OPEN_CONNS=20
EDUMART_DB_MAX_IDLE_CONNS=10

# EDUMART_METRICS_TOKEN=
# EDUMART_BACKUP_HEARTBEAT=/var/lib/edumart/backup-heartbeat.json

# Origins allowed to call the API directly (native clients, Expo dev server).
EDUMART_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ── Web (apps/web) ──────────────────────────────────────────────────────────
# The Next.js server proxies /v1/* here; the browser only ever talks to the web origin.
EDUMART_API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false in production: framing is blocked by default outside development.
EDUMART_ALLOW_FRAMING=false

# ── Outbound messages (apps/api) ───────────────────────────────────────────
# Origin used to build the links inside emails (invitations). Point it at the web app.
EDUMART_WEB_URL=http://localhost:3000
# log  = write messages to the structured log (development default; bodies redacted in production)
# smtp = deliver through an SMTP relay (SES, Postmark, Mailgun, Postfix, Mailpit ...)
EDUMART_NOTIFY=log
# EDUMART_NOTIFY=smtp
# EDUMART_SMTP_HOST=smtp.example.com
# EDUMART_SMTP_PORT=587
# EDUMART_SMTP_USERNAME=apikey
# EDUMART_SMTP_PASSWORD=change_me
# EDUMART_SMTP_FROM=no-reply@edumart.ng
# starttls (587) | tls (465, implicit) | none (local relay only, needs the opt-in below)
# EDUMART_SMTP_TLS=starttls
# EDUMART_SMTP_ALLOW_INSECURE=false

# ── Verification (apps/api) ────────────────────────────────────────────────
# HMAC key protecting stored verification codes. Any value works locally; production must set a
# secret, because the default is public and rotating this invalidates outstanding codes.
EDUMART_VERIFICATION_SECRET=dev-verification-secret
# "production" switches the log sender to redact codes and warns about missing providers.
EDUMART_ENV=development

# ── Tests (apps/api) ────────────────────────────────────────────────────────
# Set to run the Go suite against a real PostgreSQL instead of a throwaway SQLite file.
# EDUMART_TEST_POSTGRES_DSN=postgres://edumart:local_only_change_me@localhost:5432/edumart_test?sslmode=disable

# ── Mobile (apps/mobile) ────────────────────────────────────────────────────
# Absolute API base for the native app. On a device, use your machine's LAN address.
EXPO_PUBLIC_API_URL=http://localhost:8080
