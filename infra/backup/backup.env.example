# ── Backup target ───────────────────────────────────────────────────────────────────────────────
# Where backups are written, and how they are addressed. Copy to /etc/edumart/backup.env and make it
# readable only by the backup user: it holds a database password.

# The engine and the DSN the backup script reads from.
EDUMART_BACKUP_ENGINE=postgres
EDUMART_BACKUP_DSN=postgres://edumart:change_me@127.0.0.1:5432/edumart?sslmode=disable

# Retention. Daily backups cover a bad deploy; weekly ones cover "nobody noticed for a fortnight".
EDUMART_BACKUP_KEEP_DAILY=7
EDUMART_BACKUP_KEEP_WEEKLY=4

# The primary destination: local disk, sized for a week of dumps.
EDUMART_BACKUP_DEST=/var/backups/edumart

# The off-site destination. Point this at a mounted object-storage path (s3fs, gcsfuse, an NFS mount to
# another datacentre) — or leave it unset and accept that a disk failure takes the backups with it.
# The script re-reads the checksum of every copy, so a mount that silently fails to write is caught.
EDUMART_BACKUP_MIRROR=/mnt/offsite/edumart

# Where the WAL archive lives for point-in-time recovery. Must be a different device from the database.
EDUMART_WAL_ARCHIVE=/mnt/offsite/edumart-wal

# PostgreSQL client binaries, if they are not on PATH.
PGBIN=/usr/lib/postgresql/17/bin
