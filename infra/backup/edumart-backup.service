# Take a backup, apply retention, verify the newest copy and mirror it off-site.
#
#   sudo cp edumart-backup.service edumart-backup.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now edumart-backup.timer
#   systemctl list-timers edumart-backup.timer       # confirm the next run
#   sudo systemctl start edumart-backup.service      # run one now, before trusting the schedule
#
# A schedule nobody has triggered is a cron entry, not a backup. Run the service by hand first and read
# the journal: `journalctl -u edumart-backup -n 50`.
[Unit]
Description=Edumart database backup and verification
Documentation=file:///opt/edumart/docs/BACKUP_AND_RECOVERY.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=edumart-backup
Group=edumart-backup
EnvironmentFile=/etc/edumart/backup.env
# The verification step restores into a scratch database, so the DSN must allow creating one.
WorkingDirectory=/opt/edumart
ExecStart=/usr/bin/python3 /opt/edumart/scripts/backup.py \
    --engine ${EDUMART_BACKUP_ENGINE} \
    --dsn ${EDUMART_BACKUP_DSN} \
    --dest ${EDUMART_BACKUP_DEST} \
    --mirror ${EDUMART_BACKUP_MIRROR} \
    --keep-daily ${EDUMART_BACKUP_KEEP_DAILY} \
    --keep-weekly ${EDUMART_BACKUP_KEEP_WEEKLY} \
    --heartbeat ${EDUMART_BACKUP_HEARTBEAT}
# The verify step re-writes the heartbeat with verified: true. Order matters: a heartbeat that says
# "verified" before anything was restored would be the one lie this file exists to prevent.
ExecStartPost=/usr/bin/python3 /opt/edumart/scripts/backup.py \
    --verify --dest ${EDUMART_BACKUP_DEST} --heartbeat ${EDUMART_BACKUP_HEARTBEAT}
# A backup that fails must be loud: the unit failing is what an alert hangs off — and so is a heartbeat that
# stops advancing, since a unit that has been disabled fails at nothing at all.
TimeoutStartSec=900
Nice=10
IOSchedulingClass=best-effort

[Install]
WantedBy=multi-user.target
